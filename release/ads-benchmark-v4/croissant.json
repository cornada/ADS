  "@type": "sc:Dataset",
  "name": "ADS-Unified-v4",
  "description": "Agent-Didactic Spaces (ADS) benchmark dataset for multi-stakeholder curriculum evaluation. Contains 27,586 deduplicated courses from 7 universities (MIT, UC Berkeley, Stanford, UIUC, Cornell, KTH Sweden, Edinburgh UK) across 3 countries, linked to 1,016 O*NET occupations and 62 institutional mission statements. Includes O*NET structured data (skills, tasks, technology), CIP-SOC crosswalks, time-travel market drift analysis (4 O*NET versions 2022-2025), and reference experiment results (Pareto sets, baselines, goal sensitivity).",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "url": "https://github.com/ads-research/ads-unified-v4",
  "version": "4.0.1",
  "datePublished": "2026-02-07",
  "creator": [
    {
      "@type": "sc:Organization",
      "name": "ADS Research Team"
    }
  ],
  "keywords": [
    "education",
    "curriculum",
    "multi-objective optimization",
    "Pareto",
    "benchmark",
    "courses",
    "universities",
    "O*NET",
    "labor market",
    "KDD"
  ],
